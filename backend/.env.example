# Copy to backend/.env. Without a key Mothusi runs on its offline demo model.
NVIDIA_API_KEY=nvapi-your-key-here

# auto (live if a key is set) | nvidia | mock
MOTHUSI_LLM_PROVIDER=auto
MOTHUSI_LLM_MODEL=nvidia/nemotron-3-nano-omni-30b-a3b-reasoning
# Larger model for South African-language translation and back-checking
MOTHUSI_LANGUAGE_MODEL=nvidia/nemotron-3-ultra-550b-a55b
# Tasks where the planning model reasons before answering (others answer directly, which is faster)
MOTHUSI_REASONING_TASKS=lesson_analyst,adaptation_designer,reviewer
MOTHUSI_LLM_TIMEOUT=180
MOTHUSI_MAX_DESIGN_ATTEMPTS=3
MOTHUSI_MAX_MATERIAL_ATTEMPTS=2
# Seconds the offline model waits per call so the live timeline is watchable
MOTHUSI_MOCK_DELAY=0.6
MOTHUSI_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Database. Without MOTHUSI_DATABASE_URL Mothusi uses a local SQLite file (MOTHUSI_DB_PATH).
# MOTHUSI_DB_PATH=data/mothusi.db
# For Supabase: Project Settings > Database > Connection string > URI, "Session pooler" (works on IPv4 hosts).
# Replace [YOUR-PASSWORD]; if the password has symbols such as @ : / # ?, URL-encode them.
# MOTHUSI_DATABASE_URL=postgresql://postgres.your-project-ref:[YOUR-PASSWORD]@aws-0-your-region.pooler.supabase.com:5432/postgres?sslmode=require

# Password-reset emails (optional; without them the link is written to the server log)
# MOTHUSI_PUBLIC_URL=https://your-frontend.example
# MOTHUSI_SMTP_HOST=smtp.example.com
# MOTHUSI_SMTP_PORT=587
# MOTHUSI_SMTP_USER=
# MOTHUSI_SMTP_PASSWORD=
# MOTHUSI_SMTP_FROM=Mothusi <no-reply@example.com>
