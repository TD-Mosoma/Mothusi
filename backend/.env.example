# Copy to backend/.env. Without a key Mothusi runs on its offline demo model.
NVIDIA_API_KEY=nvapi-your-key-here

# auto (live if a key is set) | nvidia | mock
MOTHUSI_LLM_PROVIDER=auto
MOTHUSI_LLM_MODEL=nvidia/nemotron-3-nano-omni-30b-a3b-reasoning
# Larger model for Setswana, isiZulu and isiXhosa translation and back-checking
MOTHUSI_LANGUAGE_MODEL=nvidia/nemotron-3-ultra-550b-a55b
# Tasks where the planning model reasons before answering (others answer directly, which is faster)
MOTHUSI_REASONING_TASKS=lesson_analyst,adaptation_designer,reviewer
MOTHUSI_LLM_TIMEOUT=180
MOTHUSI_MAX_DESIGN_ATTEMPTS=3
MOTHUSI_MAX_MATERIAL_ATTEMPTS=2
# Seconds the offline model waits per call so the live timeline is watchable
MOTHUSI_MOCK_DELAY=0.6
MOTHUSI_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# MOTHUSI_DB_PATH=data/mothusi.db
