{
	"version": "2.0.0",
	"tasks": [
		{
			"label": "Mothusi Backend",
			"type": "shell",
			"command": "uv",
			"args": ["run", "uvicorn", "main:app", "--reload", "--port", "8000"],
			"options": { "cwd": "${workspaceFolder}/backend" },
			"isBackground": true,
			"problemMatcher": []
		},
		{
			"label": "Mothusi Frontend",
			"type": "shell",
			"command": "npm",
			"windows": { "command": "npm.cmd" },
			"args": ["run", "dev", "--", "--host", "127.0.0.1"],
			"options": { "cwd": "${workspaceFolder}/frontend" },
			"isBackground": true,
			"problemMatcher": []
		},
		{
			"label": "Mothusi: run everything",
			"dependsOn": ["Mothusi Backend", "Mothusi Frontend"],
			"problemMatcher": []
		}
	]
}
